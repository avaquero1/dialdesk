# The control VM's settings: copy to /etc/vha/deploy.env on control (root, 0600) and fill in the real values.
# deploy/scripts/deploy.sh reads it as data (KEY=value lines, no quotes, no shell), and the same file is Compose's
# and the deploy containers' --env-file. It holds no secret itself: keys and passwords are files under /etc/vha/inputs/,
# put there over ssh (never by mail, never in this repo). Example values are documentation addresses (RFC 5737).

# The public name (must match the site in deploy/Caddyfile) and the network.
VHA_HOSTNAME=vultrcontest.vaquerothe.dev
PUBLIC_IF=enp1s0
VPC_IF=enp8s0
# The only address SSH is open to (andre's home address).
ADMIN_IP=203.0.113.10
# The sandbox machine's VPC address: runner calls sandbox-manager on :8200.
SANDBOX_VPC_IP=10.1.96.4
# The egress bridge's /24 (compose.control.yml gives each container a fixed address in it).
EGRESS_PREFIX=172.31.250

# Managed PostgreSQL, over the VPC (the database's VPC host). PG_IP: its VPC address for the firewall; leave it
# empty to resolve PG_HOST at deploy time. TLS always (require, or verify-ca / verify-full).
PG_HOST=vultr-prod-pg.example.invalid
PG_IP=10.1.96.5
PG_PORT=16751
PG_DATABASE=defaultdb
PG_SSLMODE=require
# The admin login that runs db-init.sql. Its password is only in the pgpass file (one line,
# host:port:database:user:password, mode 0600; escape ":" and "\" in the password with "\").
PG_ADMIN_USER=vultradmin
PG_ADMIN_PASSFILE=/etc/vha/inputs/pg-admin.pgpass
# 1 = no Managed Postgres: the fallback Postgres container on control (compose profile local-db).
VHA_LOCAL_DB=0

# Object Storage. Leave S3_ENDPOINT empty to keep screenshots and audit heads in local folders (the fallback).
# Credential files: access_key_id=... and secret_access_key=... lines. The same file twice when one key reaches both.
S3_ENDPOINT=https://ewr1.vultrobjects.com
S3_REGION=us-east-1
S3_BUCKET_SCREENSHOTS=vha-screenshots-example
S3_BUCKET_HEADS=vha-audit-heads-example
S3_HEADS_LOCK_DAYS=30
S3_SCREENSHOTS_CREDENTIALS=/etc/vha/inputs/s3-screenshots
S3_HEADS_CREDENTIALS=/etc/vha/inputs/s3-heads

# Keys copied into the one container that uses each (empty or missing: an empty file, named in the secrets report).
VULTR_INFERENCE_KEY_FILE=/etc/vha/inputs/vultr-inference
BRAVE_KEY_FILE=/etc/vha/inputs/brave-search

# Kalshi exchanges connections may use: demo only on the public link.
CONNECTIONS_KALSHI_ENVS=demo
