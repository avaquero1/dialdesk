# Generated by scripts/dev-secrets.ts. Local dev only. Never commit .env.

# --- service tokens: <CALLER>_TOKEN_<CALLEE>, and the callee keeps only the hash in <CALLEE>_CALLERS
EDGE_TOKEN_ACCOUNTS=
EDGE_TOKEN_AGENT=
EDGE_TOKEN_AUDIT=
EDGE_TOKEN_BOARD=
EDGE_TOKEN_CONNECTIONS=
EDGE_TOKEN_MODELS=
AGENT_TOKEN_BOARD=
AGENT_TOKEN_MARKETS=
AGENT_TOKEN_MODELS=
RUNNER_TOKEN_BOARD=
RUNNER_TOKEN_CONNECTIONS=
RUNNER_TOKEN_MARKETS=
RUNNER_TOKEN_MODELS=
RUNNER_TOKEN_SANDBOX_MANAGER=
BOARD_TOKEN_MARKETS=
BOARD_TOKEN_RUNNER=
ACCOUNTS_CALLERS=edge:<sha256 of the caller token>
AGENT_CALLERS=edge:<sha256 of the caller token>
AUDIT_CALLERS=edge:<sha256 of the caller token>
BOARD_CALLERS=edge:<sha256 of the caller token>,agent:<sha256 of the caller token>,runner:<sha256 of the caller token>
CONNECTIONS_CALLERS=edge:<sha256 of the caller token>,runner:<sha256 of the caller token>
MODELS_CALLERS=edge:<sha256 of the caller token>,agent:<sha256 of the caller token>,runner:<sha256 of the caller token>
MARKETS_CALLERS=agent:<sha256 of the caller token>,runner:<sha256 of the caller token>,board:<sha256 of the caller token>
SANDBOX_MANAGER_CALLERS=runner:<sha256 of the caller token>
RUNNER_CALLERS=board:<sha256 of the caller token>

# --- Postgres (deploy/compose.dev.yml, deploy/db-init.sql)
PG_SUPERUSER_PASSWORD=
DB_PASSWORD_ACCOUNTS=
ACCOUNTS_DATABASE_URL=postgres://svc_accounts:@127.0.0.1:55432/app
DB_PASSWORD_BOARD=
BOARD_DATABASE_URL=postgres://svc_board:@127.0.0.1:55432/app
DB_PASSWORD_AGENT=
AGENT_DATABASE_URL=postgres://svc_agent:@127.0.0.1:55432/app
DB_PASSWORD_RUNNER=
RUNNER_DATABASE_URL=postgres://svc_runner:@127.0.0.1:55432/app
DB_PASSWORD_MARKETS=
MARKETS_DATABASE_URL=postgres://svc_markets:@127.0.0.1:55432/app
DB_PASSWORD_CONNECTIONS=
CONNECTIONS_DATABASE_URL=postgres://svc_connections:@127.0.0.1:55432/app
DB_PASSWORD_MODELS=
MODELS_DATABASE_URL=postgres://svc_models:@127.0.0.1:55432/app
DB_PASSWORD_AUDIT=
AUDIT_DATABASE_URL=postgres://svc_audit:@127.0.0.1:55432/app

# --- Valkey: one ACL user per service
VALKEY_HEALTH_PASSWORD=
EDGE_VALKEY_URL=redis://svc-edge:@127.0.0.1:56379
ACCOUNTS_VALKEY_URL=redis://svc-accounts:@127.0.0.1:56379
BOARD_VALKEY_URL=redis://svc-board:@127.0.0.1:56379
AGENT_VALKEY_URL=redis://svc-agent:@127.0.0.1:56379
RUNNER_VALKEY_URL=redis://svc-runner:@127.0.0.1:56379
MARKETS_VALKEY_URL=redis://svc-markets:@127.0.0.1:56379
CONNECTIONS_VALKEY_URL=redis://svc-connections:@127.0.0.1:56379
MODELS_VALKEY_URL=redis://svc-models:@127.0.0.1:56379
AUDIT_VALKEY_URL=redis://svc-audit:@127.0.0.1:56379

# --- models: Vultr Serverless Inference. The key lives in its own file (one line, mode 600), never in .env.
# Blank = the default: key file /run/secrets/vultr-inference, caps $5/day global, $0.25 and 200000 tokens per account, 30 calls/min.
MODELS_VULTR_KEY_FILE=
MODELS_DAILY_CAP_USD=
MODELS_ACCOUNT_DAILY_USD=
MODELS_ACCOUNT_DAILY_TOKENS=
MODELS_ACCOUNT_RPM=
MODELS_KILL=
MODELS_KEY_FINGERPRINTS=

# --- markets: cache times in seconds (the defaults are shown) and where it reads the Brave key. The key itself never goes here.
# MARKETS_QUOTE_TTL_S=15        (10-30)
# MARKETS_LIST_TTL_S=30
# MARKETS_HISTORY_TTL_S=60
# MARKETS_FEED_TTL_S=600
# MARKETS_SEARCH_TTL_S=1800     (one Brave search per game per 30 min, shared by every follower)
# MARKETS_FEED_MAX_AGE_H=96
# MARKETS_SOURCE_ENV=prod       (fixture: read the fixture rows of the source catalog instead)
# MARKETS_BRAVE_KEY_FILE=      (an absolute path; the default is ~/.config/siren/secrets/brave-search)

# --- sessions: Ed25519. The private key file is accounts' only; edge gets the public key (comma list during a rotation)
ACCOUNTS_SESSION_KEY_FILE=
EDGE_SESSION_PUBLIC_KEYS=
# kid <kid>
EDGE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080

# --- run a service as its in-memory fake: <SVC>_FAKE=1 (npm run fake -w services/<svc> sets it)
# ports: edge 8080, accounts 8101, board 8102, agent 8103, runner 8104, markets 8105, connections 8106, models 8107, audit 8108, sandbox-manager 8200, egress-proxy 8201, fixtures 8300
# board keeps screenshots in BOARD_SCREENSHOT_DIR until Object Storage exists (default .data/board/screenshots)
LOG_LEVEL=info
