      },
      "plan_hash": {
        "description": "sha256 hex of the plan's canonical JSON.",
        "type": "string"
      },
      "receipts": {
        "items": {
          "$ref": "#/$defs/Receipt"
        },
        "type": "array"
      }
    },
    "required": [
      "ok",
      "engine_version",
      "git_hash",
      "plan_hash",
      "input_hash",
      "plan",
      "numbers",
      "receipts",
      "errors"
    ],
    "title": "EngineResult",
    "type": "object"
  }
