{
  "input": {
    "$defs": {
      "OpCall": {
        "additionalProperties": false,
        "description": "One op call.",
        "properties": {
          "args": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Arg name -> a key in `numbers`, or the id of an earlier op.",
            "type": "object"
          },
          "id": {
            "description": "Slot-safe id, unique in the plan, e.g. \"n1\". Must not equal a key in `numbers`.",
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "type": "string"
          },
          "op": {
            "$ref": "#/$defs/OpName"
          }
        },
        "required": [
          "id",
          "op",
          "args"
        ],
        "type": "object"
      },
      "OpName": {
        "description": "The fixed op set.",
        "oneOf": [
          {
            "const": "implied_probability",
            "description": "args: price_cents. Probability 0..1 = price / 100.",
            "type": "string"
          },
          {
            "const": "price_to_odds",
            "description": "args: probability. Decimal odds = 1 / p.",
            "type": "string"
          },
          {
            "const": "odds_to_probability",
            "description": "args: decimal_odds. Probability = 1 / odds.",
            "type": "string"
          },
          {
            "const": "expected_value",
            "description": "args: price_cents, probability. Cents per contract = p * 100 - price.",
            "type": "string"
          },
          {
            "const": "movement",
            "description": "args: series, window_s. Points moved over the window.",
            "type": "string"
          },
          {
            "const": "volatility",
            "description": "args: series. Stddev of point-to-point changes, in points.",
            "type": "string"
          },
          {
            "const": "gap",
            "description": "args: a_cents, b_cents. b - a in points.",
            "type": "string"
          },
          {
            "const": "base_rate",
            "description": "args: hits, total. hits / total.",
            "type": "string"
          },
          {
            "const": "base_rate_history",
            "description": "args: history, lo_cents (optional), hi_cents (optional). Share of resolved\nmarkets priced in lo..=hi that resolved YES; the receipt holds the sample size.",
            "type": "string"
          },
          {
            "const": "position_value",
            "description": "args: count, price_cents. Dollars.",
            "type": "string"
          },
          {
            "const": "pnl",
            "description": "args: count, avg_price_cents, price_cents. Dollars.",
            "type": "string"
          }
        ]
      },
      "Origin": {
        "description": "Where a named input came from. There is no \"model\" origin: a model's number can\nnever be tagged, so it can never be `expected_value`'s probability.",
        "oneOf": [
          {
            "const": "user",
            "description": "The user's own number (the widget's \"your probability\" control).",
            "type": "string"
          },
          {
            "const": "market",
            "description": "An exchange's price, from markets.",
            "type": "string"
          },
          {
            "const": "history",
            "description": "Resolved markets from history, from markets.",
            "type": "string"
          },
          {
            "const": "connection",
            "description": "The user's connected account (positions), from connections.",
            "type": "string"
          }
        ]
      },
      "Plan": {
        "additionalProperties": false,
        "description": "The ops to run, in order. Later ops may read earlier ops' outputs.",
        "properties": {
          "ops": {
            "items": {
              "$ref": "#/$defs/OpCall"
            },
            "type": "array"
          },
          "plan_version": {
            "description": "Must be 1.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "plan_version",
          "ops"
        ],
        "type": "object"
      },
      "Point": {
        "additionalProperties": false,
        "description": "One point of a price series.",
        "properties": {
          "t": {
            "description": "Unix seconds.",
            "format": "int64",
            "type": "integer"
          },
          "v": {
            "description": "Price in cents (0..=100).",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "t",
          "v"
        ],
        "type": "object"
      },
      "Resolved": {
        "additionalProperties": false,
        "description": "One resolved market: its price before it resolved, and how it resolved.",
        "properties": {
          "outcome": {
            "description": "1 when it resolved YES, 0 when NO.",
            "format": "double",
            "type": "number"
          },
          "price_cents": {
            "description": "YES price in cents (0..=100) before it resolved.",
            "format": "double",
            "type": "number"
          },
          "t": {
            "description": "Unix seconds when the price was taken.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "t",
          "price_cents",
          "outcome"
        ],
        "type": "object"
      },
      "Value": {
        "anyOf": [
          {
            "format": "double",
            "type": "number"
          },
          {
            "items": {
              "$ref": "#/$defs/Point"
            },
            "type": "array"
          },
          {
            "items": {
              "$ref": "#/$defs/Resolved"
            },
            "type": "array"
          }
        ],
        "description": "A named input: a single number, a price series, or a history of resolved markets."
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "One engine run: a plan and the named numbers it reads.",
    "properties": {
      "numbers": {
        "additionalProperties": {
          "$ref": "#/$defs/Value"
        },
        "description": "Named inputs. Op args refer to them by key.",
        "type": "object"
      },
      "origins": {
        "additionalProperties": {
          "$ref": "#/$defs/Origin"
        },
        "description": "Where each named input came from, by key in `numbers`. An untagged input is\nusable by every op except as `expected_value`'s probability.",
        "type": "object"
      },
      "plan": {
        "$ref": "#/$defs/Plan"
      }
    },
    "required": [
      "plan",
      "numbers"
    ],
    "title": "EngineInput",
    "type": "object"
  },
