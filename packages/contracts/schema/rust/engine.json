        "type": "object"
      },
      "Unit": {
        "description": "The unit of a computed number.",
        "oneOf": [
          {
            "enum": [
              "dollars",
              "ratio"
            ],
            "type": "string"
          },
          {
            "const": "probability",
            "description": "0..=1.",
            "type": "string"
          },
          {
            "const": "decimal_odds",
            "description": "Decimal odds, >= 1.",
            "type": "string"
          },
          {
            "const": "cents",
            "description": "Cents per contract.",
            "type": "string"
          },
          {
            "const": "points",
            "description": "Price points (1 point = 1 cent of price).",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Everything one run produced: the plan as run, its hash and the input hash, the\nnumbers and their receipts. `ok` is true when there are no errors.",
    "properties": {
      "engine_version": {
        "type": "string"
      },
      "errors": {
        "items": {
          "$ref": "#/$defs/OpError"
        },
        "type": "array"
      },
      "git_hash": {
        "type": "string"
      },
