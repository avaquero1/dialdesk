        "description": "The plan's refs, by arg name: a key in `numbers` or an earlier op's id.",
        "type": "object"
      },
      "sample_size": {
        "description": "How many records the number rests on (base_rate_history).",
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "unit": {
        "$ref": "#/$defs/Unit"
      },
      "value": {
        "format": "double",
        "type": "number"
      }
