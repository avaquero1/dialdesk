{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["packages/*/src", "packages/*/scripts", "packages/*/test", "services/*/src", "services/*/test", "e2e", "tests", "sandbox/dev", "sandbox/test", "scripts", "deploy/*.ts", "vitest.config.ts", "eslint.config.js"]
}
